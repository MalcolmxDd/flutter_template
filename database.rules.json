{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "scannedCodes": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["userId", "scannedAt"],
      "$codeId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "user_stats": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "config": {
       ".read": "auth != null",
       ".write": "auth != null"
     },
     "products": {
       ".read": "auth != null",
       ".write": "auth != null",
       ".indexOn": ["name", "price", "stock", "barcode"],
       "$productId": {
         ".read": "auth != null",
         ".write": "auth != null"
       }
     },
     "sales": {
       ".read": "auth != null",
       ".write": "auth != null",
       ".indexOn": ["userId", "date", "productId"],
       "$saleId": {
         ".read": "auth != null",
         ".write": "auth != null"
       }
     }
  }
}